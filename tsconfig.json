{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM"],
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "types": ["node"],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "noEmit": true
    },
    "include": [
        "api/**/*.ts",
        "data/**/*.ts",
        "fixtures/**/*.ts",
        "pages/**/*.ts",
        "tests/**/*.ts",
        "playwright.config.ts"
    ]
}
