# Copy to `.env` (which is gitignored) before running the suite:
#   cp .env.example .env
#
# These are TestMart's seeded demo accounts — they are not secrets, and they are the
# only accounts guaranteed to survive the app's in-memory DB reset. See CLAUDE.md.

# Which role `fixtures/base.fixture.ts` authenticates as. One of: user | admin
TEST_ROLE=user

# Seeded customer — user.name is "John Doe"
USER_EMAIL=user@demo.com
USER_PASSWORD=user123

# Seeded admin — user.name is "Admin User", gets nav-admin
ADMIN_EMAIL=admin@demo.com
ADMIN_PASSWORD=admin123
